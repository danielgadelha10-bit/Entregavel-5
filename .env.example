# Configurações do Docker Compose (Sistema de Gestão Comercial)
# Copie este arquivo para ".env" na raiz do projeto e personalize os segredos antes de rodar em produção.
# Use senhas alfanuméricas ou devidamente URL-encoded em POSTGRES_PASSWORD.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gestao_comercial
POSTGRES_PORT=5432

BACKEND_PORT=3001
FRONTEND_PORT=3000
NODE_ENV=production
TZ=America/Sao_Paulo

JWT_SECRET=defina-uma-chave-jwt-secreta-forte-aqui
JWT_EXPIRES_IN=7d
VITE_API_URL=/api
